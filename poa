#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT_DIR"
. "$ROOT_DIR/scripts/sp1-docker-env.sh"

case "${1:-}" in
    bootstrap)
        shift
        exec "$ROOT_DIR/scripts/bootstrap.sh" "$@"
        ;;
    doctor)
        shift
        exec "$ROOT_DIR/scripts/doctor.sh" "$@"
        ;;
    profile-sp1)
        shift
        exec "$ROOT_DIR/scripts/profile_sp1_phases.sh" "$@"
        ;;
    benchmark|bench)
        shift
        exec "$ROOT_DIR/scripts/benchmark_simple.sh" "$@"
        ;;
    benchmark-matrix|bench-matrix)
        shift
        exec "$ROOT_DIR/scripts/benchmark_matrix.sh" "$@"
        ;;
    sp1-setup)
        shift
        exec cargo run --quiet --release -p sp1-host --bin poa-protocol-sp1-setup -- "$@"
        ;;
    sp1-network-build)
        shift
        exec cargo build --release --manifest-path "$ROOT_DIR/tools/sp1-network-worker/Cargo.toml" "$@"
        ;;
    sp1-cuda-build)
        shift
        [ "$(uname -s)" = "Linux" ] || {
            echo "SP1 CUDA requires Linux x86_64." >&2
            exit 1
        }
        [ "$(uname -m)" = "x86_64" ] || {
            echo "SP1 CUDA requires Linux x86_64; found $(uname -m)." >&2
            exit 1
        }
        exec cargo build --locked --release --manifest-path "$ROOT_DIR/tools/sp1-cuda-worker/Cargo.toml" "$@"
        ;;
esac

exec cargo run --quiet --release -p poa-cli -- "$@"
