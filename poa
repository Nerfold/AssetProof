#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT_DIR"
. "$ROOT_DIR/scripts/sp1-docker-env.sh"

case "${1:-}" in
    bootstrap)
        shift
        exec "$ROOT_DIR/scripts/bootstrap.sh" "$@"
        ;;
    doctor)
        shift
        exec "$ROOT_DIR/scripts/doctor.sh" "$@"
        ;;
    profile-sp1)
        shift
        exec "$ROOT_DIR/scripts/profile_sp1_phases.sh" "$@"
        ;;
    sp1-setup)
        shift
        exec cargo run --quiet --release -p sp1-host --bin poa-protocol-sp1-setup -- "$@"
        ;;
    sp1-network-build)
        shift
        exec cargo build --release --manifest-path "$ROOT_DIR/tools/sp1-network-worker/Cargo.toml" "$@"
        ;;
    sp1-cuda-build)
        shift
        [ "$(uname -s)" = "Linux" ] || {
            echo "SP1 CUDA requires Linux x86_64." >&2
            exit 1
        }
        [ "$(uname -m)" = "x86_64" ] || {
            echo "SP1 CUDA requires Linux x86_64; found $(uname -m)." >&2
            exit 1
        }
        command -v nvidia-smi >/dev/null 2>&1 || {
            echo "nvidia-smi is unavailable; attach an NVIDIA GPU and driver first." >&2
            exit 1
        }
        nvidia-smi -L >/dev/null 2>&1 || {
            echo "NVIDIA driver cannot access a GPU inside this container." >&2
            exit 1
        }
        exec cargo build --release --manifest-path "$ROOT_DIR/tools/sp1-cuda-worker/Cargo.toml" "$@"
        ;;
esac

exec cargo run --quiet --release -p poa-cli -- "$@"
